&lt;p style=&quot; margin-top:0px; margin-bottom:25px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; background-color:#fcfcfc;&quot;&gt;&lt;span style=&quot; font-family:'Open Sans','sans-serif'; font-size:14px; color:#444444; background-color:#fcfcfc;&quot;&gt;Copyright 2021, 2022 Alec Bloss&lt;/span&gt;&lt;/p&gt;
